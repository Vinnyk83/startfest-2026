DATABASE_URL="postgresql://user:password@host:5432/dbname"
SESSION_SECRET="generate-32-plus-random-chars"
CONFERENCE_START_DATE="2026-09-04"
CONFERENCE_TIMEZONE="America/Denver"
APP_BASE_URL="http://localhost:3000"
FORCE_ADMIN_PASSWORD_CHANGE="false"

# Day 2 features — magic-link auth, avatar storage, realtime chat/presence.
# Get these from Supabase dashboard -> Settings -> API Keys (same project as DATABASE_URL).
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."

# Live session notes — speech-to-text + speaker diarization.
DEEPGRAM_API_KEY=""

# Live session notes — summary + action items (Grok via xAI's API, OpenAI-compatible).
# Without this set, recordings still transcribe fine; the summary field just
# says so instead of a generated summary.
XAI_API_KEY=""
XAI_MODEL="grok-4"
